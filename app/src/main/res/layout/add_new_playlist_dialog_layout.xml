<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="25dp">

    <TextView
        android:id="@+id/add_songs_to_playlist_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:text="@string/enter_playlist_name"
        android:textAppearance="?android:attr/textAppearanceMedium"/>

    <EditText
        android:id="@+id/new_playlist_name_text_field"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/add_songs_to_playlist_info"
        android:layout_alignParentRight="true"
        android:layout_below="@+id/add_songs_to_playlist_info"
        android:layout_marginLeft="-5dp"
        android:ems="10"
        android:hint="@string/playlist_name"/>

</RelativeLayout>