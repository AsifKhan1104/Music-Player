<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          package="com.squad.music"
          android:hardwareAccelerated="true">

    <uses-sdk
        android:minSdkVersion="15"
        android:targetSdkVersion="25"
        tools:node="merge"/>

    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.GET_ACCOUNTS"/>
    <uses-permission android:name="android.permission.USE_CREDENTIALS"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_SETTINGS"/>

    <application
        android:name=".Common"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:replace="android:icon">
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version"/>
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/fb_app_id"/>

        <activity android:name=".ui.activity.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Used for Google Play Store Campaign Measurement -->
        <!-- <service android:name="com.google.analytics.tracking.android.CampaignTrackingService" /> -->

        <service android:name=".service.AudioPlaybackService"/>
        <service android:name=".service.AutoFetchAlbumArtService"/>
        <service android:name=".service.PinGMusicSongsService"/>
        <service
            android:name=".service.LargeWidgetAdapterService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS"/>
        <service
            android:name=".service.BuildMusicLibraryService"
            android:exported="false"/>
        <service
            android:name=".service.DashClockExtensionService"
            android:icon="@drawable/dashclock_icon"
            android:label="@string/app_full_name"
            android:permission="com.google.android.apps.dashclock.permission.READ_EXTENSION_DATA">
            <intent-filter>
                <action android:name="com.google.android.apps.dashclock.Extension"/>
            </intent-filter>

            <meta-data
                android:name="protocolVersion"
                android:value="2"/>
            <meta-data
                android:name="worldReadable"
                android:value="true"/>
            <meta-data
                android:name="description"
                android:value="@string/dashclock_description"/>
        </service>

        <!--
        <receiver
            android:name="com.google.analytics.tracking.android.CampaignTrackingReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.vending.INSTALL_REFERRER" />
            </intent-filter>
        </receiver>
        -->


        <!-- Large Widget -->

        <receiver
            android:name=".widget.LargeWidgetProvider"
            android:label="Jams Large Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/large_widget_info"/>
        </receiver>

        <!-- Blurred Widget -->

        <receiver
            android:name=".widget.BlurredWidgetProvider"
            android:label="Jams Blurred Album Art Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/blurred_widget_info"/>
        </receiver>

        <!-- Album Art Widget -->

        <receiver
            android:name=".widget.AlbumArtWidgetProvider"
            android:label="Jams Album Art Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/album_art_widget_info"/>
        </receiver>

        <!-- Listens for media playback buttons (headphone buttons, bluetooth buttons, etc.) -->

        <receiver android:name=".receiver.HeadsetButtonsReceiver">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>

        <!-- Small Widget -->

        <receiver
            android:name=".widget.SmallWidgetProvider"
            android:label="Jams Small Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/small_widget_info"/>
        </receiver>

        <!-- Widget/Notification Now Playing Activity Broadcast Receiver -->

        <receiver android:name=".receiver.LaunchNowPlayingReceiver">
            <intent-filter>
                <action android:name="com.squad.music.LAUNCH_NOW_PLAYING_ACTION"/>
            </intent-filter>
        </receiver>

        <!-- Widget/Notification Play/Pause Broadcast Receiver -->

        <receiver android:name=".receiver.PlayPauseBroadcastReceiver">
            <intent-filter>
                <action android:name="com.squad.music.PLAY_PAUSE_ACTION"/>
            </intent-filter>
        </receiver>

        <!-- Widget/Notification Previous Broadcast Receiver -->

        <receiver android:name=".receiver.PreviousBroadcastReceiver">
            <intent-filter>
                <action android:name="com.squad.music.PREVIOUS_ACTION"/>
            </intent-filter>
        </receiver>

        <!-- Widget/Notification Next Broadcast Receiver -->

        <receiver android:name=".receiver.NextBroadcastReceiver">
            <intent-filter>
                <action android:name="com.squad.music.NEXT_ACTION"/>
            </intent-filter>
        </receiver>

        <!-- Stop Service Broadcast Receiver -->

        <receiver android:name=".receiver.StopServiceBroadcastReceiver">
            <intent-filter>
                <action android:name="com.squad.music.STOP_SERVICE"/>
            </intent-filter>
        </receiver>

        <!-- Receiver that gets called when the user changes songs from the Large Widget -->

        <receiver android:name=".receiver.ChangeTrackBroadcastReceiver">
            <intent-filter>
                <action android:name="com.squad.music.WIDGET_CHANGE_TRACK"/>
            </intent-filter>
        </receiver>

        <activity
            android:name=".ui.activity.MainActivity"
            android:label="@string/title_activity_main">
            <meta-data
                android:name="android.app.default_searchable"
                android:value=".ui.activity.SearchActivity"/>
        </activity>
        <activity
            android:name=".ui.activity.WelcomeActivity"
            android:label="@string/app_name"/>
        <activity
            android:name=".ui.activity.LauncherActivity"
            android:label="@string/app_name"/>
        <activity
            android:name=".ui.activity.NowPlayingActivity"
            android:exported="true"
            android:label="@string/now_playing"
            android:launchMode="singleTask"/>
        <activity
            android:name=".ui.activity.EqualizerActivity"
            android:exported="true"
            android:label="@string/equalizer"/>

        <!-- Large widget configuration activity -->

        <activity android:name=".widget.LargeWidgetConfigActivity">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
            </intent-filter>
        </activity>

        <!-- Small widget configuration activity -->

        <activity android:name=".widget.SmallWidgetConfigActivity">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
            </intent-filter>
        </activity>

        <!-- Dummy activity that launches Fragment dialogs from the Main Settings Activity -->

        <activity
            android:name=".ui.activity.PreferenceDialogLauncherActivity"
            android:label="@string/app_name"/>

        <!-- Now Playing Queue Activity -->

        <activity
            android:name=".ui.activity.NowPlayingQueueActivity"
            android:label="@string/now_playing_queue"/>

        <!-- Blacklist Manager -->

        <activity
            android:name=".ui.activity.BlacklistManagerActivity"
            android:label="@string/title_activity_blacklist_manager"/>

        <!-- Music Libraries Editor Activity -->

        <activity
            android:name=".ui.activity.MusicLibraryEditorActivity"
            android:label="@string/music_library_editor"/>

        <!-- Music Libraries Editor Activity -->

        <activity
            android:name=".ui.activity.PlaylistEditorActivity"
            android:label="@string/playlists"/>
        <activity
            android:name=".ui.activity.BrowserSubListActivity"
            android:label="@string/title_activity_browser_sub"/>
        <activity
            android:name=".ui.activity.BrowserSubGridActivity"
            android:label="@string/title_activity_browsser_sub_grid"/>
        <activity android:name=".ui.activity.PlayListDetailActivity"/>
        <activity
            android:name=".ui.activity.SearchActivity"
            android:label="@string/title_activity_search">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH"/>
            </intent-filter>
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable"
                android:value=".ui.activity.SearchActivity"/>
        </activity>
    </application>

</manifest>